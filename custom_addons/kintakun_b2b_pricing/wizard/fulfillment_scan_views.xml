<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kintakun_fulfillment_scan_view_form" model="ir.ui.view">
        <field name="name">kintakun.fulfillment.scan.form</field>
        <field name="model">kintakun.fulfillment.scan</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-success" role="status" invisible="not last_message">
                    <field name="last_message"/>
                </div>
                <group>
                    <field name="picking_id"/>
                    <field name="barcode" default_focus="1"/>
                    <field name="quantity"/>
                </group>
                <footer>
                    <button name="action_scan" string="Catat" type="object" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Selesai" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
