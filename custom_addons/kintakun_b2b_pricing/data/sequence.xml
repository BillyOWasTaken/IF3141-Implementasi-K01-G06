<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_kintakun_so_queue" model="ir.sequence">
        <field name="name">Antrean SO Kintakun</field>
        <field name="code">kintakun.so.queue</field>
        <field name="padding">0</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_kintakun_sync_log" model="ir.sequence">
        <field name="name">Log Sinkronisasi Kintakun</field>
        <field name="code">kintakun.sync.log</field>
        <field name="prefix">SYNC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
