<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kintakun_sync_log_view_tree" model="ir.ui.view">
        <field name="name">kintakun.sync.log.tree</field>
        <field name="model">kintakun.sync.log</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" decoration-danger="state == 'failed'"
                  decoration-muted="state == 'resolved'">
                <field name="name"/>
                <field name="sync_date"/>
                <field name="log_type"/>
                <field name="sale_id"/>
                <field name="partner_id" optional="show"/>
                <field name="picking_id" optional="show"/>
                <field name="invoice_id"/>
                <field name="amount_total" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="payment_state" widget="badge" optional="show"
                       decoration-success="payment_state in ('paid', 'in_payment')"
                       decoration-warning="payment_state == 'not_paid'"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'success'"
                       decoration-danger="state == 'failed'"/>
                <field name="user_id" optional="hide"/>
                <button name="action_retry" string="Sinkron Ulang" type="object"
                        icon="fa-refresh" invisible="state != 'failed' or log_type != 'invoice'"
                        groups="kintakun_base.group_manajer_finance,kintakun_base.group_manajer_it"/>
            </tree>
        </field>
    </record>

    <record id="kintakun_sync_log_view_form" model="ir.ui.view">
        <field name="name">kintakun.sync.log.form</field>
        <field name="model">kintakun.sync.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header>
                    <button name="action_retry" string="Sinkron Ulang" type="object"
                            class="oe_highlight"
                            invisible="state != 'failed' or log_type != 'invoice'"
                            groups="kintakun_base.group_manajer_finance,kintakun_base.group_manajer_it"/>
                    <field name="state" widget="statusbar" statusbar_visible="success"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Sinkronisasi">
                            <field name="log_type"/>
                            <field name="sync_date"/>
                            <field name="user_id"/>
                        </group>
                        <group string="Dokumen">
                            <field name="sale_id"/>
                            <field name="partner_id"/>
                            <field name="picking_id"/>
                            <field name="invoice_id"/>
                        </group>
                        <group string="Faktur" invisible="not invoice_id">
                            <field name="invoice_date"/>
                            <field name="amount_total"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="invoice_state"/>
                            <field name="payment_state"/>
                        </group>
                    </group>
                    <group string="Keterangan">
                        <field name="message" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kintakun_sync_log_view_search" model="ir.ui.view">
        <field name="name">kintakun.sync.log.search</field>
        <field name="model">kintakun.sync.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="sale_id"/>
                <field name="partner_id"/>
                <field name="invoice_id"/>
                <filter name="failed" string="Gagal" domain="[('state', '=', 'failed')]"/>
                <filter name="success" string="Berhasil" domain="[('state', '=', 'success')]"/>
                <separator/>
                <filter name="stock" string="Stok" domain="[('log_type', '=', 'stock')]"/>
                <filter name="invoice" string="Faktur" domain="[('log_type', '=', 'invoice')]"/>
                <filter name="payment" string="Pembayaran" domain="[('log_type', '=', 'payment')]"/>
                <group expand="0" string="Kelompokkan">
                    <filter name="group_sale" string="Sales Order" context="{'group_by': 'sale_id'}"/>
                    <filter name="group_type" string="Jenis Log" context="{'group_by': 'log_type'}"/>
                    <filter name="group_date" string="Tanggal" context="{'group_by': 'sync_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="kintakun_sync_log_action" model="ir.actions.act_window">
        <field name="name">Log Sinkronisasi</field>
        <field name="res_model">kintakun.sync.log</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">Belum ada sinkronisasi</p>
            <p>Log tercatat otomatis saat surat jalan divalidasi, faktur disahkan, dan pembayaran diterima.</p>
        </field>
    </record>
</odoo>
