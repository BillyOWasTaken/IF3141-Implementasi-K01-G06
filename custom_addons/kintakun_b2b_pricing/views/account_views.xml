<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_view_form_kintakun" model="ir.ui.view">
        <field name="name">account.move.form.kintakun</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="kintakun_sale_id" invisible="not kintakun_sale_id"/>
                <field name="kintakun_agent_tier" invisible="not kintakun_sale_id"/>
            </xpath>
        </field>
    </record>

    <record id="account_move_view_search_kintakun" model="ir.ui.view">
        <field name="name">account.move.search.kintakun</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="kintakun_sale_id"/>
                <filter name="kintakun_b2b" string="Faktur Agen B2B"
                        domain="[('kintakun_sale_id', '!=', False)]"/>
                <filter name="kintakun_unpaid" string="Belum Lunas"
                        domain="[('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]"/>
            </xpath>
        </field>
    </record>

    <record id="kintakun_invoice_action" model="ir.actions.act_window">
        <field name="name">Faktur Agen B2B</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="account.view_out_invoice_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('kintakun_sale_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">Belum ada faktur agen</p>
            <p>Draf faktur terbentuk otomatis setelah surat jalan divalidasi gudang.</p>
        </field>
    </record>
</odoo>
