<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_users_view_form_kintakun" model="ir.ui.view">
        <field name="name">res.users.form.kintakun</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="before">
                <page string="Role Kintakun" name="kintakun_role">
                    <group>
                        <group>
                            <field name="kintakun_role" widget="radio"/>
                        </group>
                        <group>
                            <div class="text-muted" colspan="2">
                                Memilih role mengganti seluruh hak akses Kintakun pengguna ini
                                beserta akses Sales, Purchase, Inventory, dan Accounting yang
                                melekat pada role tersebut.
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="res_users_view_tree_kintakun" model="ir.ui.view">
        <field name="name">res.users.tree.kintakun</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='login']" position="after">
                <field name="kintakun_role"/>
            </xpath>
        </field>
    </record>
</odoo>
