<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_kintakun" model="ir.module.category">
        <field name="name">Kintakun</field>
        <field name="sequence">5</field>
    </record>

    <record id="group_kintakun_user" model="res.groups">
        <field name="name">Pengguna Kintakun</field>
        <field name="category_id" ref="module_category_kintakun"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_staf_sales" model="res.groups">
        <field name="name">Staf Sales</field>
        <field name="category_id" ref="module_category_kintakun"/>
        <field name="implied_ids" eval="[
            (4, ref('group_kintakun_user')),
            (4, ref('base.group_partner_manager')),
            (4, ref('sales_team.group_sale_salesman_all_leads')),
        ]"/>
    </record>

    <record id="group_manajer_sales" model="res.groups">
        <field name="name">Manajer Sales</field>
        <field name="category_id" ref="module_category_kintakun"/>
        <field name="implied_ids" eval="[
            (4, ref('group_staf_sales')),
            (4, ref('sales_team.group_sale_manager')),
        ]"/>
    </record>

    <record id="group_staf_inventory" model="res.groups">
        <field name="name">Staf Inventory</field>
        <field name="category_id" ref="module_category_kintakun"/>
        <field name="implied_ids" eval="[
            (4, ref('group_kintakun_user')),
            (4, ref('stock.group_stock_user')),
        ]"/>
    </record>

    <record id="group_manajer_inventory" model="res.groups">
        <field name="name">Manajer Inventory</field>
        <field name="category_id" ref="module_category_kintakun"/>
        <field name="implied_ids" eval="[
            (4, ref('group_staf_inventory')),
            (4, ref('stock.group_stock_manager')),
        ]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_manajer_procurement" model="res.groups">
        <field name="name">Manajer Procurement</field>
        <field name="category_id" ref="module_category_kintakun"/>
        <field name="implied_ids" eval="[
            (4, ref('group_kintakun_user')),
            (4, ref('stock.group_stock_user')),
            (4, ref('purchase.group_purchase_manager')),
        ]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_manajer_finance" model="res.groups">
        <field name="name">Manajer Finance</field>
        <field name="category_id" ref="module_category_kintakun"/>
        <field name="implied_ids" eval="[
            (4, ref('group_kintakun_user')),
            (4, ref('account.group_account_manager')),
            (4, ref('account.group_account_user')),
        ]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_direktur" model="res.groups">
        <field name="name">Direktur Utama</field>
        <field name="category_id" ref="module_category_kintakun"/>
        <field name="implied_ids" eval="[
            (4, ref('group_manajer_sales')),
            (4, ref('stock.group_stock_user')),
            (4, ref('purchase.group_purchase_user')),
            (4, ref('account.group_account_readonly')),
        ]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_manajer_it" model="res.groups">
        <field name="name">Manajer IT</field>
        <field name="category_id" ref="module_category_kintakun"/>
        <field name="implied_ids" eval="[
            (4, ref('group_kintakun_user')),
            (4, ref('base.group_system')),
        ]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
